# Supabase - get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (optional) - for admin + customer emails. Get API key at https://resend.com
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=3D Print Site <notifications@yourdomain.com>
# SITE_URL=https://yourdomain.com
